# Copy to .env and fill in. Never commit .env.

# docker compose (optional): password and host ports, if the defaults clash
# POSTGRES_PASSWORD=sentinel
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# shared
DATABASE_URL=
REDIS_URL=

# llm: LLM_PROVIDER is openai or anthropic; LLM_CACHE is 1 in tests, CI and evals
# local Ollama: LLM_PROVIDER=anthropic, LLM_BASE_URL=http://localhost:11434, LLM_API_KEY=ollama
# Claude API: leave LLM_BASE_URL empty
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
AGENT_MODEL=
JUDGE_MODEL=
LLM_CACHE=1
LLM_DAILY_BUDGET_USD=

# sdk (in the demo agents)
SENTINEL_API_KEY=
SENTINEL_ENDPOINT=

# workers
ONLINE_EVAL_SAMPLE_RATE=0.10
DRIFT_WINDOW_MINUTES=
EMBEDDING_MODEL=

# alerts
SLACK_WEBHOOK_URL=

# dashboard
NEXT_PUBLIC_API_URL=
SENTINEL_READ_KEY=
